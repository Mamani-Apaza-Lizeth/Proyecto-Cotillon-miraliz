# =============================================================================
# Cotillón MiraLiz · Variables de entorno de EJEMPLO
# -----------------------------------------------------------------------------
# 1) Copie este archivo como ".env" en la misma carpeta (raíz del proyecto).
# 2) Reemplace los marcadores <...> por sus valores reales.
# 3) Nunca suba ".env" a GitHub (ya está en .gitignore).
#
# Vite SOLO expone al navegador las variables que empiezan con VITE_.
# Todo lo que empieza con VITE_ termina dentro del JavaScript público:
# NUNCA ponga aquí claves secretas (service_role, sb_secret_, sk_test_, sk_live_, whsec_).
# =============================================================================

# --- PÚBLICAS (navegador) -----------------------------------------------------
# Supabase → Project Settings → API (o "Connect"): Project URL
VITE_SUPABASE_URL=https://<id-de-su-proyecto>.supabase.co
# Supabase → Project Settings → API Keys: clave "Publishable" (sb_publishable_...)
# o, en proyectos antiguos, la clave legacy "anon" (JWT largo).
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_xxxxxxxxxxxxxxxxxxxx>

# Stripe → Developers → API keys → "Publishable key" de MODO PRUEBA (pk_test_...).
# Opcional: si se deja vacío, el pago con tarjeta aparece deshabilitado.
VITE_STRIPE_PUBLISHABLE_KEY=

# URL pública de la app (se usa en los correos de recuperación de contraseña).
VITE_SITE_URL=http://localhost:5173

# =============================================================================
# SECRETAS (servidor) — NO van en este archivo.
# Se configuran en Supabase → Edge Functions → Secrets, o con:
#   npx supabase secrets set STRIPE_SECRET_KEY=sk_test_... STRIPE_WEBHOOK_SECRET=whsec_...
# Vea supabase/functions/.env.example y el manual (capítulo 9).
# =============================================================================
